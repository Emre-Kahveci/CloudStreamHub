      }
    },
    {
      "name": "HDFilmCehennemi",
      "module": "HDFilmCehennemi",
      "enabled": true,
      "language": "tr",
      "types": [
        "Movie",
        "TvSeries"
      ],
      "domainKey": "HDFilmCehennemi",
      "healthTier": "full",
