{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "providers": [
    {
      "name": "AnimeciX",
      "module": "AnimeciX",
      "enabled": true,
      "language": "tr",
      "types": [
        "Anime"
      ],
      "domainKey": "AnimeciX",
      "healthTier": "full",
      "smokeTest": {
        "searchQuery": "Naruto",
        "knownDetail": "https://animecix.tv/titles/naruto",
        "expectedType": "Anime"
      },
      "monitoring": {
        "preferredFetch": "HTTP",
        "dynamicFallback": false,
        "stealthFallback": true,
        "contentType": "Anime",
        "playerProbe": {
          "mode": "episode",
          "episodeSelector": "a[href*='/titles/'], a[href*='bolum']"
        },
        "search": {
          "method": "GET",
          "path": "/?s={query}",
          "expectedSelector": "a.poster, a.item, div.title-card"
        }
      }
    },
    {
      "name": "BelgeselX",
      "module": "BelgeselX",
      "enabled": true,
      "language": "tr",
      "types": [
        "Documentary"
      ],
      "domainKey": "BelgeselX",
      "healthTier": "full",
      "smokeTest": {
        "searchQuery": "dunya",
        "knownDetail": "https://belgeselx.com/belgesel/gezegenimiz",
