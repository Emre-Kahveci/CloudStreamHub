        "playerProbe": {
          "mode": "episode",
          "episodeSelector": "a[href*='bolum'], a[href*='video/'], #bolumler a"
        },
        "search": {
          "method": "POST_FORM",
          "path": "/ajax/arama",
          "payload": {
            "arama": "{query}"
          },
          "headers": {
            "Content-Type": "application/x-www-form-urlencoded",
            "X-Requested-With": "XMLHttpRequest"
          },
          "expectedKeyword": "/anime/"
        }
      }
    },
