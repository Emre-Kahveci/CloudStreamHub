        "expectedType": "TvSeries"
      },
      "monitoring": {
        "preferredFetch": "HTTP",
        "dynamicFallback": true,
        "stealthFallback": true,
        "contentType": "TvSeries",
        "playerProbe": {
          "mode": "episode",
          "episodeSelector": "a[href*='bolum'], a[href*='sezon'], .episode-item a, a.episode"
        },
        "search": {
          "method": "GET",
          "path": "/find?q={query}",
          "expectedSelector": "article a, a.poster, .movie-box a"
        }
      }
    },
    {
