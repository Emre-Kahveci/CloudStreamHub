      },
      "monitoring": {
        "preferredFetch": "HTTP",
        "dynamicFallback": true,
        "stealthFallback": true,
        "contentType": "Movie",
        "playerProbe": {
          "mode": "detail"
        },
        "search": {
          "method": "POST_JSON",
          "path": "/search/",
          "payload": {
            "query": "{query}"
          },
          "headers": {
            "Content-Type": "application/json",
            "X-Requested-With": "fetch"
          },
          "jsonKey": "results"
        }
      }
    },
    {
