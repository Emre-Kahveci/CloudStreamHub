      "monitoring": {
        "preferredFetch": "HTTP",
        "dynamicFallback": true,
        "stealthFallback": true,
        "contentType": "Documentary",
        "playerProbe": {
          "mode": "detail"
        },
        "search": {
          "method": "GET",
          "path": "/?s={query}",
          "expectedSelector": "a[href*='/belgesel/'], div.panel a, .video-item a"
        }
      }
    },
    {
      "name": "DiziPal",
      "module": "DiziPal",
      "enabled": true,
      "language": "tr",
